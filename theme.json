			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/button": {
				"color": {
					"background": "var(--wp--preset--color--custom-orange-05)"
				},
				"spacing": {
					"padding": {
						"bottom": "8px",
						"left": "18px",
						"right": "18px",
						"top": "8px"
					}
				},
				"typography": {
					"fontSize": "16px"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--custom-orange-01)"
		},
		"css": ".wp-block-button__link img {\n  vertical-align: middle;\n}",
		"elements": {
			"button": {
				"color": {
					"text": "var(--wp--preset--color--custom-orange-02)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mulish)",
					"fontSize": "30px",
					"fontStyle": "normal",
					"fontWeight": "600"
				}
			},
			"h1": {
				"color": {
					"text": "var(--wp--preset--color--custom-orange-06)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kalam)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "normal",
					"fontWeight": "700"
				}
			},
			"h2": {
				"color": {
					"text": "var(--wp--preset--color--custom-vert-04)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kalam)",
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--custom-vert-04)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kalam)",
					"fontStyle": "normal",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--custom-vert-01)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mulish)",
					"fontSize": "18px",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			}
		},
		"spacing": {
			"padding": {
				"bottom": "0px",
				"left": "2rem",
				"right": "2rem",
				"top": "0px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--mulish)"
		}
	}
}